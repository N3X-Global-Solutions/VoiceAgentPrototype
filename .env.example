# Copy to .env and fill in. Never commit .env.

# Required: Sarvam API key (dashboard -> API keys). Used for STT, LLM and TTS.
SARVAM_API_KEY=your_sarvam_api_key_here

# Phone calls only: the public https URL that reaches this backend (for example
# your ngrok URL: https://xxxx.ngrok-free.app). Leave empty for browser-only testing.
PUBLIC_BASE_URL=

# Credit guards (apply to every call)
MAX_CALL_SECONDS_CAP=300
MAX_COST_PER_CALL_INR=5

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Exotel (optional)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_FLOW_APP_ID=
