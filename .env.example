# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- voice AI providers
# Each agent picks a provider for speech recognition, the AI model and the voice
# (agent → Providers tab). Set the keys of the providers you use; a provider without
# a key shows "not set" in the UI and its calls are refused.

# Sarvam (dashboard -> API keys): speech recognition, AI model, voice.
SARVAM_API_KEY=your_sarvam_api_key_here

# Navana / Bodhi (platform.navana.ai, key looks like bd_...): speech recognition and voice.
# No AI model. Legacy bodhi.navana.ai accounts: also set NAVANA_CUSTOMER_ID and
# NAVANA_STT_URL=wss://bodhi.navana.ai.
NAVANA_API_KEY=
NAVANA_CUSTOMER_ID=
# NAVANA_STT_URL=wss://stt.navana.ai
# NAVANA_TTS_URL=https://tts.navana.ai/tts/bytes

# Gnani / Vachana (app.gnani.ai): speech recognition, voice, and the Evon AI model
# (Evon needs early access; free plan = 1 request at a time, 100K tokens/day).
GNANI_API_KEY=

# ---------------------------------------------------------------- server (production)
# The app's domain. Its DNS A record (in Cloudflare) must point at the VPS.
# Only read by the optional Caddy container; with Nginx it is just for reference.
DOMAIN=voicepilot.n3xglobalsolutions.com

# Public https URL of this app. Phone providers (Twilio/Exotel) call back to it, and
# Settings → Telephony webhooks shows URLs built from it.
# On the VPS: https://voicepilot.n3xglobalsolutions.com. Locally: your ngrok URL, or empty.
PUBLIC_BASE_URL=https://voicepilot.n3xglobalsolutions.com

# Admin sign-in (the only account). Changing these and restarting signs everyone out.
ADMIN_EMAIL=admin@n3xglobalsolutions.com
ADMIN_PASSWORD=n3xadminpassword
# Signs login sessions. Generate one with: openssl rand -hex 32
# (If empty, one is generated and stored in the data volume.)
SESSION_SECRET=
SESSION_TTL_HOURS=72
# Encrypts clients' Exotel/Plivo credentials in the database (Fernet key). Leave empty to have one
# generated in the data dir; back it up with the database, or clients must re-enter their keys.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# ---------------------------------------------------------------- credit guards (every call)
MAX_CALL_SECONDS_CAP=300
# Voice AI cost cap per call (phone line not included). ~Rs 2.8/min at current rates.
MAX_COST_PER_CALL_INR=10

# ---------------------------------------------------------------- cost rates (INR, before GST)
# Each call is billed at the rates of the providers its agent uses. Copy your real rates
# from each provider's console; Settings → Cost rates shows what's in effect.
# Sarvam (pay-as-you-go, Nov 2026). STT is billed per second of speech sent.
PRICE_TTS_PER_1K_CHARS=2.00
PRICE_STT_PER_MIN=0.49
PRICE_LLM_INPUT_PER_1M=10
PRICE_LLM_CACHED_PER_1M=0.25
PRICE_LLM_OUTPUT_PER_1M=25
# Navana. TTS is the published launch price (Rs 12 per 10,000 chars). STT has no public
# price: it is billed per second CONNECTED (whole call); copy it from platform.navana.ai → Plans.
PRICE_NAVANA_TTS_PER_1K_CHARS=1.20
PRICE_NAVANA_STT_PER_MIN=0.50
# Gnani. No public prices. TTS default is the Rs 1.8/1k chars you were quoted; STT default is a
# third-party listing (Rs 27/hour). Confirm both in app.gnani.ai. Evon is free on the free plan.
PRICE_GNANI_TTS_PER_1K_CHARS=1.80
PRICE_GNANI_STT_PER_MIN=0.45
PRICE_GNANI_LLM_INPUT_PER_1M=0
PRICE_GNANI_LLM_CACHED_PER_1M=0
PRICE_GNANI_LLM_OUTPUT_PER_1M=0
# Phone line, per minute, billed in whole pulses from answer. Copy your rate from your invoice.
PRICE_EXOTEL_PER_MIN=0.80
EXOTEL_PULSE_SECS=60
PRICE_TWILIO_PER_MIN=0
TWILIO_PULSE_SECS=60
# Default for clients' own Plivo numbers (each number can set its own rate on the Clients page).
PRICE_PLIVO_PER_MIN=0
PLIVO_PULSE_SECS=60

# ---------------------------------------------------------------- Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------- Exotel (optional)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_FLOW_APP_ID=
